{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujocolab.github.io/mjlab/schema/scene-manifest-v1.json",
  "title": "mjlab 3DGS scene manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coordinate_system",
    "visual",
    "collision",
    "world_from_scene",
    "spawn_points"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "up_axis", "length_unit"],
      "properties": {
        "handedness": {"const": "right"},
        "up_axis": {"const": "z"},
        "length_unit": {"const": "meter"}
      }
    },
    "visual": {"$ref": "#/$defs/visualAsset"},
    "collision": {"$ref": "#/$defs/collisionAsset"},
    "world_from_scene": {"$ref": "#/$defs/pose"},
    "spawn_points": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/spawnPoint"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "position": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "quaternion_wxyz"],
      "properties": {
        "position": {"$ref": "#/$defs/position"},
        "quaternion_wxyz": {"$ref": "#/$defs/quaternion"}
      }
    },
    "spawnPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "position", "quaternion_wxyz"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "position": {"$ref": "#/$defs/position"},
        "quaternion_wxyz": {"$ref": "#/$defs/quaternion"}
      }
    },
    "visualAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "3dgs_ply"},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "collisionAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "mjcf"},
        "path": {"$ref": "#/$defs/relativePath"},
        "geom_group": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 5},
            {"type": "null"}
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/file"}
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}
      }
    }
  }
}
